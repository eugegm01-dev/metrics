package handler

import (
	"net/http"
	"net/http/httptest"
	"testing"

	"github.com/eugegm01-dev/metrics/internal/repository"
	"github.com/go-chi/chi/v5"
)

func TestGetMetricHandler(t *testing.T) {
	storage := repository.NewMemStorage()
	storage.UpdateCounter("test", 42)

	r := chi.NewRouter()
	r.Get("/value/{type}/{name}", GetMetricHandler(storage))

	ts := httptest.NewServer(r)
	defer ts.Close()

	// Тест существующей метрики
	resp, err := http.Get(ts.URL + "/value/counter/test")
	if err != nil {
		t.Fatalf("Failed to make request: %v", err)
	}
	defer resp.Body.Close() // ← ВОТ ЭТОГО НЕ ХВАТАЛО!

	if resp.StatusCode != http.StatusOK {
		t.Errorf("Expected 200, got %d", resp.StatusCode)
	}

	// Тест несуществующей метрики
	resp, err = http.Get(ts.URL + "/value/counter/nonexistent")
	if err != nil {
		t.Fatalf("Failed to make request: %v", err)
	}
	defer resp.Body.Close() // ← И ЗДЕСЬ ТОЖЕ!

	if resp.StatusCode != http.StatusNotFound {
		t.Errorf("Expected 404, got %d", resp.StatusCode)
	}
}
func TestUpdateHandler(t *testing.T) {
    storage := repository.NewMemStorage()
    handler := UpdateHandler(storage, "")

    // Тест gauge
    req := httptest.NewRequest("POST", "/update/gauge/test/1.23", nil)
    w := httptest.NewRecorder()
    handler.ServeHTTP(w, req)
    if w.Code != http.StatusOK {
        t.Errorf("Expected 200, got %d", w.Code)
    }
    val, ok := storage.GetGauge("test")
    if !ok || val != 1.23 {
        t.Errorf("Gauge not updated: %v, %v", val, ok)
    }

    // Тест counter
    req = httptest.NewRequest("POST", "/update/counter/test_counter/10", nil)
    w = httptest.NewRecorder()
    handler.ServeHTTP(w, req)
    if w.Code != http.StatusOK {
        t.Errorf("Expected 200, got %d", w.Code)
    }
    valC, ok := storage.GetCounter("test_counter")
    if !ok || valC != 10 {
        t.Errorf("Counter not updated: %v, %v", valC, ok)
    }

    // Неправильный тип
    req = httptest.NewRequest("POST", "/update/invalid/test/1.23", nil)
    w = httptest.NewRecorder()
    handler.ServeHTTP(w, req)
    if w.Code != http.StatusBadRequest {
        t.Errorf("Expected 400, got %d", w.Code)
    }
}
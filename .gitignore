# Go binaries and build artifacts
*.exe
*.exe~
server
agent
*.test
*.out
*.prof

# Common Go build output names (when using -o without extension)
main
agent
server
collector
sender

# When building from subdirectories (cmd/agent, cmd/server etc.)
cmd/agent/agent
cmd/agent/main
cmd/server/server
cmd/server/main

# Dependency directories
vendor/

# Go workspaces and modules cache (usually not needed, but sometimes appear)
go.work
go.work.sum

# Test coverage and profiling
coverage.*
*.coverprofile
*.cpu.pprof
*.mem.pprof

# Temporary files
*.tmp
*.bak
*~

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo

# macOS junk
.DS_Store

# Windows junk
Thumbs.db
ehthumbs.db